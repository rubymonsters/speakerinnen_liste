<div class="row">
  <div class="col-md-4">
    <p id="category_explantation" class="py-2 fw-bold"><%= t(:choose_category, scope: 'category') %></p>
    <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
      <% @categories.each do |category| %>
        <a class="h5 category-link pb-2 <%= "active show" if category.id.to_s == @category.id.to_s %>" id="v-pills-<%= category.slug %>-tab" data-bs-toggle="pill" href="#v-pills-<%= category.slug %>" role="tab" aria-controls="v-pills-<%= category.slug %>" aria-selected="false">
          <i class="fa fa-circle pe-2 small" id="icon-<%= category.slug%>"></i><%= category.name %>
        </a>
      <% end %>
    </div>
  </div>

  <div class="col-md-8">
    <p id="tags_explantation" class="py-2 fw-bold <%= "d-none" unless params[:category_id] %>"><%= t(:filter, scope: 'category') %></p>
    <% @categories.each do |category| %>
        <span id="<%= category.slug %>" class="btn btn-primary choose_all_tags mb-2 category-search category-search-<%= category.slug %> <%= "d-none" unless category.id.to_s ==  params[:category_id] %> ">
          <%= t(:choose_all_button, scope: 'category', category_name: category.name ).html_safe %>
        </span>
    <% end %>
    <div class="tab-content mb-3" id="available-tags-box">
      <% @categories.each do |category| %>
        <div style="min-height: 300px" class="tab-pane fade <%= "active show" if category.id.to_s == ( params[:category_id]  || @category.id.to_s )%>" id="v-pills-<%= category.slug %>" role="tabpanel" aria-labelledby="v-pills-<%= category.slug %>-tab" >
          <%= render partial: "shared/tagbox", locals: { :tags => instance_variable_get("@tags_#{category.slug}"), :category => category } %>
        </div>
      <% end %>
    </div>
    <div id="selected-tags-box" class="my-3">
    </div>
    <div class="mb-3 text-end">
      <%= form_tag("/profiles#speakers_anchor", method: "get") do %>
        <%= text_field_tag :tag_filter, params[:tag_filter], id: "hidden_tag_input", class: "form-control d-none" %>
        <span class="btn text-primary btn-link" id="clear"><%= t(:clear_link, scope: 'category') %></span>
        <%= hidden_field_tag("locale", params[:locale] ) if params[:locale] %>
        <%= submit_tag t(:"choose_button#{'_' + current_region.to_s if current_region}", scope: 'category'), class: "btn btn-primary", id: "search_in_topic" %>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    var availableTagsBox = document.getElementById('available-tags-box');
    var selectedTagsBox = document.getElementById('selected-tags-box');

    // the first css class of a tag is its category, e.g. "category_science"
    var categoryClassOf = function(tag) {
      return tag.classList[0];
    };

    var availableTag = function(tagName) {
      return availableTagsBox.querySelector('#' + CSS.escape(tagName));
    };

    var addToSelectedTags = function(tag) {
      var selectedTag = tag.cloneNode(true);
      selectedTag.insertAdjacentHTML('beforeend', "<i class='ps-2 fa fa-times-circle'></i>");
      selectedTag.classList.remove('available-tag');
      selectedTag.classList.add('selected-tag');
      selectedTagsBox.appendChild(selectedTag);
    };

    // category links
    document.querySelectorAll('.category-link').forEach(function(link) {
      link.addEventListener('click', function() {
        var category = this.id.split('-')[2];
        document.querySelectorAll('.category-title').forEach(function(title) { title.classList.add('d-none'); });
        var categoryTitle = document.getElementById('category-' + category);
        if (categoryTitle) categoryTitle.classList.remove('d-none');
        document.querySelectorAll('.category-search').forEach(function(button) { button.classList.add('d-none'); });
        document.querySelectorAll('.category-search-' + category).forEach(function(button) { button.classList.remove('d-none'); });
        document.getElementById('tags_explantation').classList.remove('d-none');
      });
    });

  // tag box

    // move tags from tagbox to the selecetd tag box and set the css class to disabled in the tagbox
    availableTagsBox.querySelectorAll('.available-tag').forEach(function(tag) {
      tag.addEventListener('click', function() {
        addToSelectedTags(this);
        this.classList.add('disabled', 'no-click');
        this.classList.remove('enabled');
        var category = categoryClassOf(this).split('_')[1];
        document.getElementById('icon-' + category).classList.add('icon-active-' + category);
      });
    });

    // move already selected tags back to the tag-box
    selectedTagsBox.addEventListener('click', function(event) {
      var tag = event.target.closest('.selected-tag');
      if (!tag) return;
      var categoryClass = categoryClassOf(tag);
      tag.remove();
      var originalTag = availableTag(tag.id);
      if (originalTag) {
        originalTag.classList.remove('disabled', 'no-click');
        originalTag.classList.add('enabled');
      }

      if (!selectedTagsBox.querySelector('.selected-tag.' + CSS.escape(categoryClass))) {
        var category = categoryClass.split('_')[1];
        document.getElementById('icon-' + category).classList.remove('icon-active-' + category);
      }
    });

    document.getElementById('search_in_topic').addEventListener('click', function() {
      var allTags = Array.from(selectedTagsBox.querySelectorAll('.selected-tag')).map(function(tag) {
        return tag.textContent;
      }).join();
      document.getElementById('hidden_tag_input').value = allTags;
    });

    // remove all tags fro the selecetd tag box
    document.getElementById('clear').addEventListener('click', function() {
      selectedTagsBox.querySelectorAll('.selected-tag').forEach(function(tag) { tag.remove(); });
      document.querySelectorAll('.available-tag').forEach(function(tag) {
        tag.classList.remove('disabled', 'no-click', 'enabled');
      });
      window.location = window.location.pathname;
    });

    // choose all tags from a category
    document.querySelectorAll('.choose_all_tags').forEach(function(button) {
      button.addEventListener('click', function() {
        var categoryClass = 'category_' + this.id;
        availableTagsBox.querySelectorAll('.enabled.' + CSS.escape(categoryClass)).forEach(addToSelectedTags);
        availableTagsBox.querySelectorAll('.' + CSS.escape(categoryClass)).forEach(function(tag) {
          tag.classList.add('disabled', 'no-click');
          tag.classList.remove('enabled');
        });
      });
    });

  // add the correct css classes to the tags
    var filteredTagNames = <%= raw params[:tag_filter].to_s.gsub(' ', '-').split(',').to_json %>;
    filteredTagNames.forEach(function(tagName) {
      var tag = availableTag(tagName);
      if (!tag) return;
      addToSelectedTags(tag);
      tag.classList.add('disabled', 'no-click');
    });
  })();
</script>
