<div class="row mt-5 profile-show">
  <div class="col-lg-4 col-md-6 text-center pb-3">
    <%= profile_image_link(@profile) %>
    <% unless current_profile == @profile %>
      <% if @profile.inactive? %>
        <button type="button" class="btn btn-primary btn-stretch mt-2 px-5 disabled">
          <i class="fa fa-times"></i>&nbsp;
          <%= @profile.fullname + t(:no_contact, scope: 'profiles.show') %>
        </button>
      <% else %>
        <%= render 'profiles/contact_button', profile: @profile %>
      <% end %>
    <% end %>
  </div>
  <div class="col-lg-6 col-md-6">
    <% if current_profile == @profile && @profile.inactive? %>
      <p class="alert-warning">
        <%= t(:inactive_profile, scope: 'profiles.show').html_safe %><%= link_to t(:activate_profile, scope: 'profiles.show'), edit_profile_registration_path(anchor: "inactive_anchor") %>
      </p>
    <% end %>
    <h1><%= @profile.fullname %></h1>
    <h3><%= @profile.profession %></h3>
    <!-- city and languages -->
    <% if (intro = profile_intro(@profile)) %>
      <p><%= intro %></p>
    <% end %>
    <% unless @profile.fullname.present? %>
      <p class="error">
        <%= t(:empty_profile, scope: 'profiles.show').html_safe %>
      </p>
      <p>
        <%= t(:check_faq, scope: 'profiles.show').html_safe %>
      </p>
    <% end %>
    <!-- main topic -->
    <% if @profile.main_topic.present? %>
      <p><%= t(:main_topic_html, scope: 'profiles.show', main_topic: content_tag(:strong, @profile.main_topic)) %></p>
    <% end %>
    <!-- topics -->
    <% topics = topics_for_profile(@profile).includes(:categories).to_a %>
    <% if topics.any? %>
      <div class="mb-3">
        <ul class="topic-pills list-unstyled d-flex flex-wrap gap-2 mb-0">
          <% topics.each do |topic| %>
            <li>
              <%= link_to topic.name, profiles_path(tag_filter: topic.name), class: "topic-pill topic-pill--#{topic.categories.first&.slug} badge text-lowercase" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <!-- twitter -->
    <% if @profile.twitter.present? %>
      <p>
        <span class="fw-bold">
          <%= t(:twitter, scope: 'profiles.show') %>
        </span>
        <%= link_to '@' + @profile.twitter_name_formatted, @profile.twitter_link_formatted, target: '_blank', rel: 'noopener' %>
      </p>
    <% end %>
    <!-- websites -->
    <% websites = profile_websites(@profile) %>
    <% if websites.any? %>
      <p>
        <%= t(:websites, scope: 'profiles.show') %><br>
        <%= safe_join(websites.map { |website| link_to website, url_with_protocol(website), target: '_blank', rel: 'noopener' }, tag.br) %>
      </p>
    <% end %>
    <!-- social media -->
    <% social_media_links = profile_social_media_links(@profile) %>
    <% if social_media_links.any? %>
      <ul class="list-unstyled d-flex gap-3">
        <% social_media_links.each do |url, icon| %>
          <li>
            <%= link_to url, target: "_blank", rel: "noopener", class: "social-icon" do %>
              <i class="<%= icon %>"></i>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <!-- services -->
    <% if @profile.services.any? %>
      <p>
        <%= t(:services, scope: 'profiles.show') %>
        <%= safe_join(@profile.services.map { |s| content_tag(:strong, t(s.name, scope: 'profiles.show')) }, ' · ') %>
      </p>
    <% end %>
    <!-- willing to travel and willing to talk nonprofit, only shown if true -->
    <% if @profile.willing_to_travel %>
      <p><%= t(:willing_to_travel, scope: 'profiles.show') %></p>
    <% end %>
    <% if @profile.nonprofit %>
      <p><%= t(:nonprofit, scope: 'profiles.show') %></p>
    <% end %>
  </div>

  <!-- edit action for user -->
  <div class="col-md-2">
    <% if current_profile == @profile %>
      <div class="d-grid gap-4">
        <%= link_to(edit_profile_path(@profile), class: 'button_link noHover') do %>
          <div class='btn btn-primary d-block'>
            <%= t(:edit, scope: 'profiles.show') %>
          </div>
        <% end %>
        <%= link_to(profile_medialinks_path(@profile), class: 'button_link noHover') do %>
          <div class='btn btn-primary d-block'>
            <%= t(:edit, scope: 'profiles.medialinks') %>
          </div>
        <% end %>
        <%= link_to(edit_profile_registration_path, class: 'button_link noHover') do %>
          <div id='accountSettings' class='btn btn-primary d-block'>
            <%= t(:account, scope: 'layouts.application') %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- personal note -->
<% if @profile.personal_note.present? %>
  <div class="row my-3">
    <div class="col-md-12">
        <span class="fw-bold">
          <%= t(:personal_note, scope: 'profiles.show') %>
        </span>
        <%= simple_format(@profile.personal_note, class: '') %>
    </div>
  </div>
<% end %>

<!-- bio -->
<% if @profile.bio.present? %>
  <div class="row my-3">
    <div class="col-md-12">
        <span class="fw-bold">
          <%= t(:bio, scope: 'profiles.show') %>
        </span>
        <%= simple_format(@profile.bio, class: '') %>
    </div>
  </div>
<% end %>

<!-- medialinks -->
<% if @medialinks.load.any? %>
  <div class="row">
    <div class="col-md-12">
      <p class="fw-bold">
        <%= t(:media, scope: 'profiles.show') %>
      </p>
    <%= render partial: 'profiles/medialink', collection: @medialinks %>

    </div>
  </div>
<% end %>

<div class="row">
  <div class="col-lg-4 col-md-6 text-center pb-3">
    <%# don't show the second contact button at all when the profile is not active %>
    <% unless current_profile == @profile || @profile.inactive? %>
      <%= render 'profiles/contact_button', profile: @profile %>
    <% end %>
  </div>
</div>


<!-- Modal Contact -->
<div class="modal fade" id="contactModal" tabindex="-1" role="dialog" aria-labelledby="contactModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="contactModalLabel">
          <%= "#{t(:email_to, scope: 'profiles.show' )} #{@profile.fullname}:"%>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= render partial: 'contact/form', locals: {url: contact_profile_path(@profile)} %>
      </div>
    </div>
  </div>
</div><!-- Modal -->
