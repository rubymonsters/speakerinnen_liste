<%= simple_form_for [:admin, @sharepic] do |f| %>
  <%= f.error_notification %>
  <%= f.input :title, label: t('admin.sharepics.fields.title'), input_html: { class: 'form-control' } %>
  <%= f.input :description, as: :text, label: t('admin.sharepics.fields.description'), input_html: { class: 'form-control', rows: 3 } %>
  <%= f.input :image, as: :file, label: t('admin.sharepics.fields.image'),
              hint: t('admin.sharepics.image_hint'), input_html: { accept: Sharepic::ALLOWED_CONTENT_TYPES.join(',') } %>
  <% if @sharepic.persisted? && @sharepic.image.attached? %>
    <%= image_tag @sharepic.image.variant(:thumb), width: 200, class: 'mb-3' %>
  <% end %>
  <%= f.input :position, as: :integer, label: t('admin.sharepics.fields.position'), input_html: { class: 'form-control' } %>
  <%= f.input :published, as: :boolean, label: t('admin.sharepics.fields.published') %>
  <%= f.submit t(:save, scope: 'general'), class: 'btn btn-primary btn-sm my-3' %>
<% end %>
