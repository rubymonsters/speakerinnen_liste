# Secrets referenced by config/deploy.yml (registry password + env/secret).
#
# This file IS committed, but it must only contain *references* to secrets, not
# the secret values themselves. Each line below reads the value from the
# environment of the machine running `kamal deploy` (e.g. your shell, a CI
# secret store, or a password manager via `kamal secrets fetch`).
#
# Example for a one-off deploy from your laptop:
#   export KAMAL_REGISTRY_PASSWORD=...   # registry token
#   export SECRET_KEY_BASE=$(bin/rails secret)
#   export DATABASE_URL=postgres://speakerinnen:PASSWORD@127.0.0.1:5432/speakerinnen_production
#   export REDIS_URL=redis://127.0.0.1:6379/1
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
#   export POSTMARK_API_TOKEN=...
#   export HONEYBADGER_API_KEY=...
#   export POSTGRES_PASSWORD=...

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRET_KEY_BASE=$SECRET_KEY_BASE
DATABASE_URL=$DATABASE_URL
REDIS_URL=$REDIS_URL

AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

POSTMARK_API_TOKEN=$POSTMARK_API_TOKEN
HONEYBADGER_API_KEY=$HONEYBADGER_API_KEY

POSTGRES_PASSWORD=$POSTGRES_PASSWORD
