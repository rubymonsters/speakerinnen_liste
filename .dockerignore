# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files and local secrets.
/config/master.key
/config/credentials/*.key
/.kamal/

# Local-only database config (production uses DATABASE_URL)
/config/database.yml

# Ignore database dumps, logs and tempfiles.
*.dump
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore development files
/.devcontainer
/.idea
/.ruby-lsp
/.byebug_history
/.DS_Store
/notes
/spec
/Guardfile

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
/docker-compose.yml
